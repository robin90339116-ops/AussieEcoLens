AWS_REGION=us-east-1
FILES_TABLE=AussieEcoLensFiles
NOTIFICATIONS_TABLE=AussieEcoLensNotificationsSub
CHECKSUM_INDEX=checksum-index
OWNER_INDEX=owner_id-index
SNS_TOPIC_ARN=arn:aws:sns:us-east-1:ACCOUNT_ID:AussieEcoLensNotifications
CORS_ALLOW_ORIGIN=http://localhost:3000

# Required when GCP reads DynamoDB through temporary AWS Academy credentials.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# Filled by A group
COGNITO_REGION=us-east-1
COGNITO_USER_POOL_ID=
COGNITO_APP_CLIENT_ID=

# Filled by B group. The token must stay in backend environment variables.
ORACLE_TAG_UPLOAD_URL=
ORACLE_API_TOKEN=
ORACLE_TIMEOUT_SECONDS=30

# Legacy fallback only, not the formal demo route.
ML_QUERY_LAMBDA_NAME=

# Q6 only when DB records store S3 keys instead of parseable S3 URLs
ORIGINAL_BUCKET=
THUMBNAIL_BUCKET=
PRESIGN_MEDIA_URLS=true
PRESIGNED_URL_EXPIRES_SECONDS=900

# GCP local smoke tests only. Keep true in deployed environments.
AUTH_REQUIRED=true

# Temporary fallback until A/B pass the real Cognito owner into upload metadata.
DEFAULT_OWNER_ID=unknown-owner
