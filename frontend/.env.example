# Cognito user-pool settings from member A.
VITE_AWS_REGION=ap-southeast-2
VITE_COGNITO_USER_POOL_ID=
VITE_COGNITO_CLIENT_ID=

# API roots from members A and D.
VITE_AWS_API_BASE_URL=
VITE_GCP_API_BASE_URL=

# Optional path overrides if your team uses different endpoint names.
VITE_PRESIGNED_PATH=/presigned-url
VITE_UPLOAD_STATUS_PATH=/files/status
VITE_Q1_PATH=/query/tags
VITE_Q2_PATH=/query/species
VITE_Q3_PATH=/query/thumbnail
VITE_Q4_PATH=/query/file
VITE_Q5_PATH=/tags/bulk
VITE_Q6_PATH=/files/delete
VITE_LIST_FILES_PATH=/files
VITE_SUBSCRIPTIONS_PATH=/subscriptions

# Leave true for local UI development without cloud endpoints.
VITE_USE_MOCKS=true

