# Cognito user-pool settings from member A. Required for real demo mode.
VITE_AWS_REGION=us-east-1
VITE_COGNITO_USER_POOL_ID=us-east-1_lb6SisPnD
VITE_COGNITO_CLIENT_ID=fvmq1uralbq80r9q7nrnonh73

# API roots from members A and D.
# A's current API Gateway is EcoLensAPI, id 66h13afw3g, region us-east-1.
# Ruitong's S3 CORS config allows http://localhost:3000 for local direct uploads.
# /upload/presigned and /upload/check-dup are live on the prod stage.
# If Q1/Q2 are routed through the same API Gateway, keep VITE_GCP_API_BASE_URL empty.
# If D exposes separate Cloud Functions for Q1/Q2, put that root in VITE_GCP_API_BASE_URL.
VITE_AWS_API_BASE_URL=https://66h13afw3g.execute-api.us-east-1.amazonaws.com/prod
VITE_GCP_API_BASE_URL=

# Path overrides matching A's API Gateway resource tree.
# Upload status is not present in the current resource tree, so leave it empty until A confirms a method.
# D's Q4 Lambda expects JSON with image_base64/content_type, not multipart form data.
# B's API_AUTH_TOKEN must stay in the backend. The frontend always calls Q4 through /query/by-file.
# D has not supplied a GET file-list contract, so leave VITE_LIST_FILES_PATH empty unless A/D add one.
VITE_PRESIGNED_PATH=/upload/presigned
VITE_UPLOAD_CHECK_DUP_PATH=/upload/check-dup
VITE_UPLOAD_STATUS_PATH=
VITE_Q1_PATH=/query/by-tags
VITE_Q2_PATH=/query/by-species
VITE_Q3_PATH=/query/by-thumbnail
VITE_Q4_PATH=/query/by-file
VITE_Q5_PATH=/tags/modify
VITE_Q6_PATH=/files
VITE_LIST_FILES_PATH=
VITE_SUBSCRIPTIONS_PATH=/notifications/subscribe

# C8 deployment settings for S3 + CloudFront.
VITE_DEPLOY_BUCKET=
VITE_CLOUDFRONT_DISTRIBUTION_ID=
